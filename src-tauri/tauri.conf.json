{
  "productName": "Momentum",
  "version": "0.1.0",
  "identifier": "com.momentum.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Momentum",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
