{
  "threshold": 5,
  "reporters": ["html", "console", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test/**",
    "**/database.types.ts"
  ],
  "format": ["typescript", "tsx"],
  "output": "./reports/jscpd",
  "minLines": 10,
  "minTokens": 80,
  "gitignore": true
}
